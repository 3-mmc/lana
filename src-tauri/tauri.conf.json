{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lana",
  "version": "0.1.6",
  "identifier": "io.github.threemmc.lana",
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../web/index.html": "web/index.html",
      "../web/languages.json": "web/languages.json",
      "../web/romanise.js": "web/romanise.js",
      "../web/romanise.json": "web/romanise.json",
      "../vendor/": "vendor/"
    },
    "publisher": "3-mmc",
    "copyright": "© 2026 Aaron van Blerkom. GPL-3.0-or-later. Built on Praat by Paul Boersma and David Weenink.",
    "shortDescription": "Phonetic analysis with speech-recognised tiers",
    "longDescription": "Lana (Linguistic ANAlysis) shows Praat's acoustic analysis of a recording and fills word, phone and speaker tiers by speech recognition, then exports a TextGrid. Built on Praat; not affiliated with the Praat project.",
    "homepage": "https://github.com/3-mmc/lana",
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "science"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDNkFDNjhFNDk3Nzk5QTUKUldTbG1YZEpqc1pxWE9tUkprUW1tNTlWK0pvOUN0L1U4L0drOERvZmN6ZFRxNzFjend1dlRTdU0K",
      "endpoints": [
        "https://github.com/3-mmc/lana/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
